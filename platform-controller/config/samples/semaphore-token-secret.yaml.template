# Шаблон — не коммитить с реальным значением token. Реальный токен создан вручную через
# POST /api/user/tokens (Semaphore, ADR-0014 §2, Фаза 3) под аккаунтом admin этого стенда,
# подставляется в stringData.token при apply, файл с реальным значением не хранится в git.
apiVersion: v1
kind: Secret
metadata:
  name: semaphore-api-token
  namespace: platform
type: Opaque
stringData:
  token: "<PASTE_TOKEN_HERE>"
