.vscode
.ansible
.vscode

# helm/ — пример helmwave-конфигурации (docs/adr/0007-monitoring-server-role.md §6) отслеживается
# целиком (envs/, values/, helmwave.yml(.tpl), localrepo/), кроме локального
# build/vendor-кэша и рабочих артефактов самой роли/helmwave/Claude Code:
helm/.claude/
helm/.helmwave/
helm/tmp/
# helm/helmwave.yml — единственный закоммиченный референсный рендер (K8S_CLUSTER=k3s-monitoring).
# platform/aicd (ROADMAP.md, «Предлагаемая последовательность работ», пункт 7) рендерит СВОЙ
# helmwave.yml под другим именем (--file helmwave.platform.yml) именно чтобы не перезаписывать
# этот референс при каждом прогоне своего site.yml — рендер под платформенный кластер не
# коммитится, это транзиентный артефакт запуска, не документация. platform/aicd-devops-labs-ru
# (второе, независимое окружение того же стека) по той же причине рендерит СВОЙ файл под ещё
# одним именем (--file helmwave.platform-devops-labs-ru.yml) — общего `helm/` каталога с
# platform/aicd, иначе оба стенда писали бы в один и тот же файл.
helm/helmwave.platform.yml
helm/helmwave.platform-devops-labs-ru.yml

# extensions/molecule/default/create.yml пишет сюда per-host дамп hostvars (tmp_dir из
# extensions/molecule/inventory/hosts.yml) — рабочий артефакт прогона, не фикстура. Раньше уже
# протекал в git при пустом TMPDIR (см. коммит, удаливший test-host-k3s_created.yml).
extensions/molecule/default/*_created.yml

# demo/ (ADR-0006) — состояние Terraform и сгенерированный Ansible-inventory локальны для
# каждого оператора стенда (реальные IP/пути зависят от конкретного libvirt-хоста), не
# коммитятся. .terraform.lock.hcl — не игнорируется (фиксирует версии провайдеров).
demo/*/terraform/.terraform/
demo/*/terraform/terraform.tfstate
demo/*/terraform/terraform.tfstate.backup
demo/*/terraform/*.tfplan
demo/*/terraform/crash.log
demo/*/ansible/inventory.yml

# platform/cicd (ROADMAP.md, «Предлагаемая последовательность работ», пункт 7, Фаза 0) — та же
# логика, что demo/* выше: состояние Terraform, сгенерированный inventory и снятый kubeconfig
# локальны для конкретного прогона/хоста, не коммитятся.
platform/*/terraform/.terraform/
platform/*/terraform/terraform.tfstate
platform/*/terraform/terraform.tfstate.backup
platform/*/terraform/*.tfplan
platform/*/terraform/crash.log
platform/*/ansible/inventory.yml
platform/*/ansible/.kube-tmp/

# extensions/molecule/freeipa/packer/ — Packer-шаблон для сборки собственного vagrant/libvirt box
# Rocky Linux 9 (см. molecule.yml, «История подбора бокса», п.4) отслеживается целиком (*.pkr.hcl,
# http/ks.cfg), кроме скачанного ISO и извлечённых из него ядра/initrd, и результата сборки —
# это локальные бинарные артефакты одного прогона, не фикстуры.
extensions/molecule/freeipa/packer/cache/
extensions/molecule/freeipa/packer/output-*/
extensions/molecule/freeipa/packer/*.box
