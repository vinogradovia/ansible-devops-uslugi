# Fail2Ban filter для Nginx Proxy Manager (roles/reverse_proxy_npm) — не стоковый nginx-формат
# лога, поэтому не подходят фильтры из самого пакета fail2ban (nginx-http-auth/nginx-botsearch
# рассчитаны на дефолтный combined/nginx access-лог). NPM реально использует ДВА своих формата
# (проверено реальным прогоном demo/npm, а не только чтением апстримного исходника — на
# per-proxy-host access-логе и на fallback-логе (запросы с Host, для которого нет ни одного
# proxy-host'а — самый частый случай "сканирования") разное число полей перед $status):
#
#   log_format proxy    '[$time_local] $upstream_cache_status $upstream_status $status - '
#                        '$request_method $scheme $host "$request_uri" [Client $remote_addr] ...'
#   log_format standard '[$time_local] $status - $request_method $scheme $host "$request_uri" '
#                        '[Client $remote_addr] ...'  # без cache_status/upstream_status, без [Sent-to]
#
# Пишется в /data/logs/proxy-host-<id>_access.log (per-host, формат proxy) и
# /data/logs/fallback_access.log (формат standard) — оба доступны с хоста через bind-mount
# ./data:/data (roles/reverse_proxy_npm/templates/compose-reverse-proxy-npm.yml.j2). Файл
# апстримного "log-proxy.conf" (docker/rootfs/etc/nginx/conf.d/include/log-proxy.conf) указывает
# "fallback_http_access.log" для fallback — на практике реальное имя другое
# ("fallback_access.log"), ориентируйтесь на logpath в jail, не на апстримный конфиг-файл.
#
# Банит по повторным 401/403/404 от одного client IP — эвристика "сканирование/перебор путей",
# та же идея, что nginx-botsearch/nginx-http-auth для стокового nginx-формата, адаптированная под
# оба формата NPM (опциональная группа "cache_status upstream_status" перед $status). jail должен
# указывать logpath на оба файла (см. roles/fail2ban/README.md, "Известные интеграции").

[Definition]

failregex = ^\[\S+ \S+\] (?:\S+ \S+ )?(?:401|403|404) - \S+ \S+ \S+ "[^"]*" \[Client <HOST>\]

ignoreregex =

# datepattern = {NONE} — обязателен: наш ^-anchored failregex сам вычленяет "[$time_local]" из
# начала строки, но fail2ban по умолчанию тоже пытается автоматически найти и "съесть" дату
# ГДЕ УГОДНО в строке (в т.ч. внутри тех же квадратных скобок), оставляя после себя пустой "[]"
# или обрывок — из-за этого ^\[\S+ \S+\] переставал матчиться вообще (0 из 1 строк). Найдено
# реальным прогоном extensions/molecule/fail2ban/ через fail2ban-regex -v: без {NONE} — "0
# matched, 1 missed" на заведомо корректной по формату строке; с {NONE} — совпадает.
datepattern = {NONE}
