# СГЕНЕРИРОВАНО ролью devops.uslugi.fail2ban (roles/fail2ban/templates/jail.local.j2). Правки
# будут перезаписаны следующим прогоном — редактируйте fail2ban_jails/fail2ban_bantime и т.д.
# в group_vars, не этот файл. jail.conf (пакетный, не трогаем) остаётся дефолтами апстрима —
# jail.local, штатный override-механизм самого fail2ban, полностью перезаписывается ролью
# каждый прогон (список jail'ов декларативный, см. defaults/main.yml).

[DEFAULT]
bantime = {{ fail2ban_bantime }}
findtime = {{ fail2ban_findtime }}
maxretry = {{ fail2ban_maxretry }}
ignoreip = {{ fail2ban_ignoreip | join(' ') }}
backend = {{ fail2ban_backend }}

{% for jail in fail2ban_jails %}
[{{ jail.name }}]
enabled = {{ jail.enabled | default(true) | lower }}
{% if jail.filter is defined %}
filter = {{ jail.filter }}
{% endif %}
{% if jail.logpath is defined %}
logpath = {{ (jail.logpath if jail.logpath is string else jail.logpath | join('\n           ')) }}
{% endif %}
{% if jail.port is defined %}
port = {{ jail.port }}
{% endif %}
{% if jail.backend is defined %}
backend = {{ jail.backend }}
{% endif %}
{% if jail.maxretry is defined %}
maxretry = {{ jail.maxretry }}
{% endif %}
{% if jail.findtime is defined %}
findtime = {{ jail.findtime }}
{% endif %}
{% if jail.bantime is defined %}
bantime = {{ jail.bantime }}
{% endif %}
{% if jail.action is defined %}
action = {{ jail.action }}
{% endif %}

{% endfor %}
