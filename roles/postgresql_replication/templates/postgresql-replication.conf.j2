# {{ ansible_managed }}
#
# wal_level/репликация/repmgr/archive_command для pgBackRest (ADR §4/§8). Применимо и к adopt-, и
# к fresh-install-хостам. Правка этого файла на уже работающем PostgreSQL требует рестарта службы
# — см. postgresql_replication_allow_restart (ADR §2) и handlers/main.yml.

listen_addresses = '{{ postgresql_replication_listen_addresses }}'

wal_level = replica
max_wal_senders = {{ postgresql_replication_max_wal_senders }}
max_replication_slots = {{ postgresql_replication_max_replication_slots }}
hot_standby = on

# Обязательно для `repmgr node rejoin --force-rewind`/`pg_rewind` (docs/runbooks/postgresql-
# failover.md, раздел 3, шаг 3) — без wal_log_hints (или checksums, которые требуют переинициализации
# кластера через initdb/pg_checksums, а не просто рестарта) pg_rewind отказывает с "--force-rewind
# specified but pg_rewind cannot be used". Нужно на ВСЕХ узлах заранее (до расхождения таймлайнов),
# не только на том, который потом будет rewind-иться — потому и в общем drop-in-файле, а не только
# в конфиге DR-/read-реплики.
wal_log_hints = on

# repmgr должен быть загружен на КАЖДОМ узле кластера (primary и обеих репликах), не только на
# репликах — иначе `repmgr standby switchover`/переключение ролей не работает (repmgr требует
# симметричной конфигурации preload на всех узлах).
shared_preload_libraries = 'repmgr'

{% if postgresql_replication_backup_enabled and postgresql_replication_role == postgresql_replication_backup_source_role %}
# Архивирование WAL через pgBackRest — включено только на хосте-источнике бэкапа (ADR §8).
# Включать archive_mode=on/archive_command на остальных узлах опасно: там pgBackRest-стanza не
# инициализирована, archive_command будет постоянно падать, и PostgreSQL перестанет
# recycle-ить WAL-сегменты — рост pg_wal/ до заполнения диска.
#
# archive_mode='always' (а не 'on') обязателен, если источник бэкапа — реплика (значение по
# умолчанию, ADR §8: backup_source_role=dr_replica): 'on' архивирует WAL только пока сервер
# работает как primary, standby в recovery-режиме с 'on' архивировать не будет вообще — тонкость
# PostgreSQL, не совпадающая с интуитивным ожиданием "on значит включено везде".
archive_mode = {{ 'on' if postgresql_replication_role == 'primary' else 'always' }}
{% if postgresql_replication_backup_tool == 'bareos' %}
# ROADMAP №48, Фаза 3 — bareos-fd-postgresql плагин читает WAL из wal_archive_dir=, сам его не
# архивирует. "test ! -f ... &&" — не перезаписывать уже заархивированный сегмент (тот же приём,
# что рекомендует официальная документация PostgreSQL для простого copy-archive_command).
archive_command = 'test ! -f {{ postgresql_replication_bareos_wal_archive_dir }}/%f && cp %p {{ postgresql_replication_bareos_wal_archive_dir }}/%f'
# Принудительное переключение WAL-сегмента — иначе pg_backup_stop(wait_for_archive=true) плагина
# может ждать вечно на тихой БД (см. defaults/main.yml, postgresql_replication_bareos_archive_timeout).
archive_timeout = {{ postgresql_replication_bareos_archive_timeout }}
{% else %}
archive_command = 'pgbackrest --stanza={{ postgresql_replication_pgbackrest_stanza }} archive-push %p'
{% endif %}
{% elif postgresql_replication_backup_enabled and postgresql_replication_backup_tool == 'bareos' and postgresql_replication_role == 'primary' %}
# ROADMAP №48, Фаза 3 — найдено реальным прогоном molecule: archive_timeout сам по себе не
# заставляет реплику архивировать чаще — WAL-сегмент физически переключает только primary,
# реплика лишь получает уже переключённые сегменты потоковой репликацией и архивирует то, что
# получила. Если источник бэкапа — реплика (backup_source_role=dr_replica по умолчанию, ADR §8),
# а primary archive_mode=off, WAL-сегменты на тихой БД (мало/нет записи после снятия бэкапа)
# никогда не переключаются — pg_backup_stop(wait_for_archive=true) плагина виснет часами в
# ожидании сегмента, который primary никогда не завершит. Поэтому primary тоже архивирует —
# archive_command сюда не пишет ничего полезного (никто не читает WAL-архив primary, если
# backup_source_role != primary), 'true' достаточно, чтобы XLogArchivingActive() включил
# принудительное переключение по archive_timeout.
archive_mode = always
archive_command = 'true'
archive_timeout = {{ postgresql_replication_bareos_archive_timeout }}
{% else %}
archive_mode = off
{% endif %}
