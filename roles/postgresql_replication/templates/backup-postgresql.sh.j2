#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Физический бэкап PostgreSQL через pgBackRest, выгрузка в S3 и ретеншн — всё встроено в сам
# pgBackRest (ADR §8, в отличие от mysql_replication, где для этого нужен отдельный rclone).
# Запускается systemd-таймером postgresql-backup.timer (ежедневно,
# {{ postgresql_replication_backup_time }}).
#
# Тип бэкапа выбирается pgBackRest автоматически по правилам repo1-retention-* (full/diff/incr) —
# отдельная логика классификации по дню недели/месяца, как в backup-mysql.sh.j2, здесь не нужна.

set -euo pipefail

METRICS_FILE="{{ postgresql_replication_backup_metrics_textfile_path }}"
METRICS_TMP="${METRICS_FILE}.tmp"

fail() {
  echo "postgresql-backup: FAILED: $*" >&2
  {
    echo "# HELP postgresql_backup_last_success_timestamp_seconds Unix time of the last successful PostgreSQL backup"
    echo "# TYPE postgresql_backup_last_success_timestamp_seconds gauge"
    echo "postgresql_backup_last_run_success 0"
  } > "${METRICS_TMP}"
  mv "${METRICS_TMP}" "${METRICS_FILE}"
  exit 1
}

trap 'fail "unexpected error"' ERR

sudo -u postgres pgbackrest --stanza={{ postgresql_replication_pgbackrest_stanza }} backup

{
  echo "# HELP postgresql_backup_last_success_timestamp_seconds Unix time of the last successful PostgreSQL backup"
  echo "# TYPE postgresql_backup_last_success_timestamp_seconds gauge"
  echo "postgresql_backup_last_success_timestamp_seconds $(date +%s)"
  echo "postgresql_backup_last_run_success 1"
} > "${METRICS_TMP}"
mv "${METRICS_TMP}" "${METRICS_FILE}"
