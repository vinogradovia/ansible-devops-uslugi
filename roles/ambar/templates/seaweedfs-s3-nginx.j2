{{ ansible_managed | comment }}
# SeaweedFS S3 API reverse proxy
# Generated by Ansible. Do not edit manually.

{% if ambar_nginx_reverse_proxy_ssl_certificate and ambar_nginx_reverse_proxy_ssl_certificate_key %}
server {
    listen 443 ssl http2;
    server_name {{ ambar_nginx_reverse_proxy_server_name }};

    ssl_certificate {{ ambar_nginx_reverse_proxy_ssl_certificate }};
    ssl_certificate_key {{ ambar_nginx_reverse_proxy_ssl_certificate_key }};
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 0;

    location / {
        proxy_pass http://127.0.0.1:{{ ambar_s3_gateway_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name {{ ambar_nginx_reverse_proxy_server_name }};
    return 301 https://$host$request_uri;
}
{% else %}
server {
    listen 80;
    server_name {{ ambar_nginx_reverse_proxy_server_name }};

    client_max_body_size 0;

    location / {
        proxy_pass http://127.0.0.1:{{ ambar_s3_gateway_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
{% endif %}
