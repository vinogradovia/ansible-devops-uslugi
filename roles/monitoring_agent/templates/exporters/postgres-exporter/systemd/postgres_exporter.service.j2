[Unit]
Description=Postgres Exporter

[Service]
User={{ monitoring_agent_postgres_exporter_systemd_name }}
Environment=PG_EXPORTER_ENV_CHECKSUM={{ monitoring_agent_postgres_exporter_env_stat.checksum }}
EnvironmentFile={{ monitoring_agent_config_dir }}/.postgres_exporter.env
ExecStart={{ monitoring_agent_postgres_exporter_binary_install_path }} --web.listen-address :{{ monitoring_agent_postgres_exporter_port }}

[Install]
WantedBy=multi-user.target
