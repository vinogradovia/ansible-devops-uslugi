#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Физический бэкап ({{ mysql_replication_backup_tool }}) + выгрузка в S3 через rclone + ретеншн
# (ADR §8). Запускается systemd-таймером mysql-backup.timer (ежедневно, {{ mysql_replication_backup_time }}).
#
# Классификация daily/weekly/monthly — по дню запуска: 1-е число месяца -> monthly, понедельник
# -> weekly, иначе daily. Ретеншн применяется ко всем трём префиксам rclone-фильтром --min-age,
# так что бэкап, попавший в weekly/monthly, не удаляется правилом daily.

set -euo pipefail

REMOTE="mysql_backup_s3:{{ mysql_replication_backup_s3_bucket }}"
TIMESTAMP="$(date +%Y-%m-%dT%H-%M-%S)"
WORKDIR="{{ mysql_replication_backup_dir }}/${TIMESTAMP}"
ARCHIVE="{{ mysql_replication_backup_dir }}/${TIMESTAMP}.tar.gz"
METRICS_FILE="{{ mysql_replication_backup_metrics_textfile_path }}"
METRICS_TMP="${METRICS_FILE}.tmp"

if [ "$(date +%d)" = "01" ]; then
  CLASS="monthly"
elif [ "$(date +%u)" = "1" ]; then
  CLASS="weekly"
else
  CLASS="daily"
fi

fail() {
  echo "mysql-backup: FAILED: $*" >&2
  {
    echo "# HELP mysql_backup_last_success_timestamp_seconds Unix time of the last successful MySQL backup"
    echo "# TYPE mysql_backup_last_success_timestamp_seconds gauge"
    echo "mysql_backup_last_run_success 0"
  } > "${METRICS_TMP}"
  mv "${METRICS_TMP}" "${METRICS_FILE}"
  exit 1
}

trap 'fail "unexpected error"' ERR

mkdir -p "${WORKDIR}"

{% if mysql_replication_backup_tool == 'xtrabackup' %}
xtrabackup --backup --target-dir="${WORKDIR}"
xtrabackup --prepare --target-dir="${WORKDIR}"
{% else %}
mariabackup --backup --target-dir="${WORKDIR}"
mariabackup --prepare --target-dir="${WORKDIR}"
{% endif %}

tar -C "${WORKDIR}" -czf "${ARCHIVE}" .
rm -rf "${WORKDIR}"

rclone copyto "${ARCHIVE}" "${REMOTE}/${CLASS}/${TIMESTAMP}.tar.gz"
rm -f "${ARCHIVE}"

# Ретеншн (ADR §8) — независимо по каждому классу.
rclone delete "${REMOTE}/daily" --min-age {{ mysql_replication_backup_retention_daily }}d
rclone delete "${REMOTE}/weekly" --min-age {{ (mysql_replication_backup_retention_weekly | int) * 7 }}d
rclone delete "${REMOTE}/monthly" --min-age {{ (mysql_replication_backup_retention_monthly | int) * 30 }}d

{
  echo "# HELP mysql_backup_last_success_timestamp_seconds Unix time of the last successful MySQL backup"
  echo "# TYPE mysql_backup_last_success_timestamp_seconds gauge"
  echo "mysql_backup_last_success_timestamp_seconds $(date +%s)"
  echo "mysql_backup_last_run_success 1"
} > "${METRICS_TMP}"
mv "${METRICS_TMP}" "${METRICS_FILE}"
