[Unit]
Description=Fail2Ban UI
After=network.target
Wants=fail2ban.service

[Service]
# root — осознанный выбор, не забытый TODO: приложению нужен доступ к
# /var/run/fail2ban/fail2ban.sock (root:root, создаётся самим fail2ban), права на чтение/запись
# /etc/fail2ban/jail.d/*.conf, чтение всего /var/log (проверка logpath перед включением jail'а)
# и systemctl restart fail2ban.service — тот же вывод, что и в комментарии к docker-compose.yml
# апстрима про privileged: true для локального fail2ban. Дедайт fail2ban не поставляется этой
# коллекцией (нет отдельной роли), поэтому сузить права выделенным пользователем без изменения
# конфигурации самого fail2ban (сокет/группы) — вне контроля этой роли.
User=root
Group=root
Type=simple

Environment=CALLBACK_URL={{ fail2ban_ui_callback_url }}
{% if fail2ban_ui_callback_secret %}
Environment=CALLBACK_SECRET={{ fail2ban_ui_callback_secret }}
{% endif %}
Environment=PORT={{ fail2ban_ui_port }}
Environment=BIND_ADDRESS={{ fail2ban_ui_bind_address }}
Environment=DISABLE_EXTERNAL_IP_LOOKUP={{ fail2ban_ui_disable_external_ip_lookup }}
Environment=UPDATE_CHECK={{ fail2ban_ui_update_check }}
Environment=AUTODARK={{ fail2ban_ui_autodark }}

WorkingDirectory={{ fail2ban_ui_config_dir }}
ExecStart={{ fail2ban_ui_binary_install_path }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
