{# monitoring_server_grafana_server_domain ВСЕГДА "defined" — у роли monitoring_server есть
   дефолт ".docker.localhost" (docker-path заглушка Traefik Host()), поэтому одного "is defined"
   недостаточно, домен берётся per-оркестратор явно. k3s-путь (docs/adr/0022-new-component-
   requirements.md §5) с 2026-09-06 имеет реальный Ingress+TLS для Grafana
   (helm/values/k3s-monitoring/namespaces/monitoring/grafana-operator/values.yaml) —
   monitoring_server_k3s_grafana_domain (roles/monitoring_server/defaults/main.yml) дублирует тот
   же домен, держите оба места синхронными при смене. #}
{% set infra_panel_monitoring_items = [] %}
{% if monitoring_server_grafana_enabled | default(false) %}
{%   set _monitoring_server_orchestrator = monitoring_server_orchestrator | default('docker') %}
{%   if _monitoring_server_orchestrator == 'docker' and monitoring_server_grafana_server_domain is defined %}
{%     set _ = infra_panel_monitoring_items.append({
         'name': 'Grafana',
         'logo': 'https://grafana.com/static/img/menu/grafana2.svg',
         'url': 'https://' + monitoring_server_grafana_server_domain,
         'target': '_blank',
       }) %}
{%   elif _monitoring_server_orchestrator == 'k3s' and monitoring_server_k3s_grafana_domain is defined %}
{%     set _ = infra_panel_monitoring_items.append({
         'name': 'Grafana',
         'logo': 'https://grafana.com/static/img/menu/grafana2.svg',
         'url': 'https://' + monitoring_server_k3s_grafana_domain,
         'target': '_blank',
       }) %}
{%   endif %}
{% endif %}
{% set infra_panel_rendered_services = ([{
     'name': infra_panel_auto_monitoring_group_name,
     'icon': infra_panel_auto_monitoring_group_icon,
     'items': infra_panel_monitoring_items,
   }] if infra_panel_monitoring_items else []) + infra_panel_extra_services %}
---
title: "{{ infra_panel_title }}"
{% if infra_panel_subtitle %}
subtitle: "{{ infra_panel_subtitle }}"
{% endif %}
columns: "{{ infra_panel_columns }}"
connectivityCheck: false
services:
  {{ infra_panel_rendered_services | to_nice_yaml(indent=2) | indent(2) }}
